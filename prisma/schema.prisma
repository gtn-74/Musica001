generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model budgets {
  budget_id                       Int        @id @default(autoincrement())
  user_id                         Int
  category_id                     Int
  year_month                      String     @db.VarChar(7)
  budget_amount                   Decimal    @db.Decimal(10, 2)
  is_deleted                      Boolean?   @default(false)
  deleted_at                      DateTime?  @db.Timestamp(6)
  deleted_by                      Int?
  updated_at                      DateTime?  @default(now()) @db.Timestamp(6)
  created_at                      DateTime?  @default(now()) @db.Timestamp(6)
  categories                      categories @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction)
  users_budgets_deleted_byTousers users?     @relation("budgets_deleted_byTousers", fields: [deleted_by], references: [user_id], onUpdate: NoAction)
  users_budgets_user_idTousers    users      @relation("budgets_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, category_id, year_month])
}

model categories {
  category_id                        Int             @id @default(autoincrement())
  user_id                            Int?
  category_name                      String          @db.VarChar(255)
  parent_category_id                 Int?
  is_system_default                  Boolean?        @default(false)
  is_deleted                         Boolean?        @default(false)
  deleted_at                         DateTime?       @db.Timestamp(6)
  deleted_by                         Int?
  updated_at                         DateTime?       @default(now()) @db.Timestamp(6)
  created_at                         DateTime?       @default(now()) @db.Timestamp(6)
  budgets                            budgets[]
  users_categories_deleted_byTousers users?          @relation("categories_deleted_byTousers", fields: [deleted_by], references: [user_id], onUpdate: NoAction)
  categories                         categories?     @relation("categoriesTocategories", fields: [parent_category_id], references: [category_id], onUpdate: NoAction)
  other_categories                   categories[]    @relation("categoriesTocategories")
  users_categories_user_idTousers    users?          @relation("categories_user_idTousers", fields: [user_id], references: [user_id], onUpdate: NoAction)
  incomes                            incomes[]
  receipt_items                      receipt_items[]
  stores_m                           stores_m[]
}

model household_members {
  household_id Int
  user_id      Int
  role         String?    @default("member") @db.VarChar(50)
  joined_at    DateTime?  @default(now()) @db.Timestamp(6)
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  households   households @relation(fields: [household_id], references: [household_id], onDelete: Cascade, onUpdate: NoAction)
  users        users      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([household_id, user_id])
}

model households {
  household_id      Int                 @id @default(autoincrement())
  household_name    String              @db.VarChar(255)
  created_by        Int
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  household_members household_members[]
  users             users               @relation(fields: [created_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model incomes {
  income_id   Int         @id @default(autoincrement())
  user_id     Int
  income_name String      @db.VarChar(255)
  amount      Decimal     @db.Decimal(10, 2)
  income_date DateTime    @db.Date
  category_id Int?
  memo        String?
  is_deleted  Boolean?    @default(false)
  deleted_at  DateTime?   @db.Timestamp(6)
  deleted_by  Int?
  updated_at  DateTime?   @default(now()) @db.Timestamp(6)
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  categories  categories? @relation(fields: [category_id], references: [category_id], onUpdate: NoAction)
  users       users       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model payment_methods {
  payment_method_id                       Int       @id @default(autoincrement())
  user_id                                 Int
  method_type                             String    @db.VarChar(50)
  card_name                               String?   @db.VarChar(255)
  card_last4                              String?   @db.VarChar(4)
  is_active                               Boolean?  @default(true)
  is_deleted                              Boolean?  @default(false)
  deleted_at                              DateTime? @db.Timestamp(6)
  deleted_by                              Int?
  updated_at                              DateTime? @default(now()) @db.Timestamp(6)
  created_at                              DateTime? @default(now()) @db.Timestamp(6)
  users_payment_methods_deleted_byTousers users?    @relation("payment_methods_deleted_byTousers", fields: [deleted_by], references: [user_id], onUpdate: NoAction)
  users_payment_methods_user_idTousers    users     @relation("payment_methods_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model receipt_items {
  item_id     Int         @id @default(autoincrement())
  receipt_id  Int
  item_name   String      @db.VarChar(255)
  quantity    Int         @default(1)
  unit_price  Decimal     @db.Decimal(10, 2)
  amount      Decimal     @db.Decimal(10, 2)
  category_id Int?
  is_deleted  Boolean?    @default(false)
  deleted_at  DateTime?   @db.Timestamp(6)
  deleted_by  Int?
  updated_at  DateTime?   @default(now()) @db.Timestamp(6)
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  categories  categories? @relation(fields: [category_id], references: [category_id], onUpdate: NoAction)
  users       users?      @relation(fields: [deleted_by], references: [user_id], onUpdate: NoAction)
  receipts    receipts    @relation(fields: [receipt_id], references: [receipt_id], onDelete: Cascade, onUpdate: NoAction)
}

model receipts {
  receipt_id                       Int             @id @default(autoincrement())
  user_id                          Int
  store_id                         Int?
  store_name                       String?         @db.VarChar(255)
  receipt_number                   String?         @db.VarChar(100)
  purchase_date                    DateTime        @db.Timestamp(6)
  total_amount                     Decimal         @db.Decimal(10, 2)
  tax_amount                       Decimal?        @db.Decimal(10, 2)
  tax_rate                         Decimal?        @db.Decimal(5, 2)
  payment_method                   String?         @db.VarChar(50)
  card_last4                       String?         @db.VarChar(4)
  image_url                        String?
  is_deleted                       Boolean?        @default(false)
  deleted_at                       DateTime?       @db.Timestamp(6)
  deleted_by                       Int?
  updated_at                       DateTime?       @default(now()) @db.Timestamp(6)
  created_at                       DateTime?       @default(now()) @db.Timestamp(6)
  receipt_items                    receipt_items[]
  users_receipts_deleted_byTousers users?          @relation("receipts_deleted_byTousers", fields: [deleted_by], references: [user_id], onUpdate: NoAction)
  stores_m                         stores_m?       @relation(fields: [store_id], references: [store_id], onUpdate: NoAction)
  users_receipts_user_idTousers    users           @relation("receipts_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model stores_m {
  store_id            Int         @id @default(autoincrement())
  store_name          String      @db.VarChar(255)
  store_code          String?     @db.VarChar(255)
  category_default_id Int?
  is_deleted          Boolean?    @default(false)
  deleted_at          DateTime?   @db.Timestamp(6)
  deleted_by          Int?
  updated_at          DateTime?   @default(now()) @db.Timestamp(6)
  created_at          DateTime?   @default(now()) @db.Timestamp(6)
  receipts            receipts[]
  categories          categories? @relation(fields: [category_default_id], references: [category_id], onUpdate: NoAction, map: "fk_stores_category_default")
  users               users?      @relation(fields: [deleted_by], references: [user_id], onUpdate: NoAction, map: "fk_stores_deleted_by")
}

model users {
  user_id                                           Int                 @id @default(autoincrement())
  user_name                                         String              @db.VarChar(255)
  email                                             String              @unique @db.VarChar(255)
  password                                          String              @db.VarChar(255)
  is_deleted                                        Boolean?            @default(false)
  deleted_at                                        DateTime?           @db.Timestamp(6)
  deleted_by                                        Int?
  updated_at                                        DateTime?           @default(now()) @db.Timestamp(6)
  created_at                                        DateTime?           @default(now()) @db.Timestamp(6)
  budgets_budgets_deleted_byTousers                 budgets[]           @relation("budgets_deleted_byTousers")
  budgets_budgets_user_idTousers                    budgets[]           @relation("budgets_user_idTousers")
  categories_categories_deleted_byTousers           categories[]        @relation("categories_deleted_byTousers")
  categories_categories_user_idTousers              categories[]        @relation("categories_user_idTousers")
  household_members                                 household_members[]
  households                                        households[]
  incomes                                           incomes[]
  payment_methods_payment_methods_deleted_byTousers payment_methods[]   @relation("payment_methods_deleted_byTousers")
  payment_methods_payment_methods_user_idTousers    payment_methods[]   @relation("payment_methods_user_idTousers")
  receipt_items                                     receipt_items[]
  receipts_receipts_deleted_byTousers               receipts[]          @relation("receipts_deleted_byTousers")
  receipts_receipts_user_idTousers                  receipts[]          @relation("receipts_user_idTousers")
  stores_m                                          stores_m[]
}
